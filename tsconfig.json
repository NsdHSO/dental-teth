{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@dental/storage": ["./packages/storage/src"],
      "@dental/http": ["./packages/http/src"],
      "@dental/i18n": ["./packages/i18n/src"],
      "@dental/auth": ["./packages/auth/src"],
      "@dental/components": ["./packages/components/src"],
    },
  },
  "references": [
    {
      "path": "packages/storage",
    },
    {
      "path": "packages/http",
    },
    {
      "path": "packages/i18n",
    },
    {
      "path": "packages/auth",
    },
    {
      "path": "packages/components",
    },
    {
      "path": "packages/types",
    },
  ],
  "include": [],
  "files": [],
  "exclude": ["node_modules", "packages/*/dist", "packages/*/node_modules"],
}
